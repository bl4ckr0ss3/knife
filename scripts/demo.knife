# Real ELF TUI frames: functions -> headers -> raw bytes -> segments ->
# section headers -> strings -> split comparison.
# No simulated loading animation or vulnerability verdicts.
size 110 30
hold 24
key down 3
key enter
hold 24
key :
type headers
key enter
hold 30
key down 4
key enter
hold 30
key z
hold 24
key z
hold 12
key backspace
key + 2
hold 18
key :
type segments
key enter
hold 30
key down
key enter
hold 24
key backspace
key :
type section-headers
key enter
hold 30
key down 2
key enter
hold 24
key backspace
key :
type strings
key enter
hold 30
key :
type functions
key enter
hold 24
key :
type compare
key enter
hold 30
key tab
hold 24
key :
type next
key enter
hold 30
key :
type only
key enter
hold 12
